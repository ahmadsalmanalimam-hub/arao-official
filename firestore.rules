rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile: Anyone can read, only owner can write
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'videoCount', 'totalLikesCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Videos: Anyone can read public, only owner can delete or create
    match /videos/{videoId} {
      allow read: if resource == null || resource.data.visibility == 'public' || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount', 'downloadCount'])
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Watch History: Private to owner
    match /watchHistory/{historyId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Not Interested: Private to owner
    match /notInterested/{id} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Likes: Logged-in users can like/unlike
    match /likes/{likeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Comments: Anyone can read, logged-in can create, only author can delete
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /commentLikes/{commentLikeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Follows: Logged-in users can follow
    match /follows/{followId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notifications: Only recipient can read or update their notifications
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.recipientId == request.auth.uid;
    }

    // Bookmarks: Only owner can access
    match /bookmarks/{bookmarkId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Conversations: Only participants can read or update
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Messages: Only participants
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
    }

    // Reports: Authenticated users can submit, only admins can read
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Blocks: Users can manage their block list
    match /blocks/{blockId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.blockerId == request.auth.uid);
    }

    // Follow Requests: Handled between requester and target
    match /followRequests/{reqId} {
      allow read, write: if request.auth != null;
    }
  }
}
